from PIL import Image, ImageDraw
from transformers import BlipProcessor, BlipForConditionalGeneration

print("===== WEEK 15: MULTIMODAL PROMPTING =====")

# 2. Automatically generate a sample.jpg if not present
image_path = "sample.jpg"
img = Image.new("RGB", (400, 300), color=(135, 206, 235))  # Sky blue background
draw = ImageDraw.Draw(img)
# Draw ground (green)
draw.rectangle([0, 200, 400, 300], fill=(34, 139, 34))
# Draw a yellow sun
draw.ellipse([30, 30, 90, 90], fill=(255, 215, 0))
# Draw a red house
draw.rectangle([150, 140, 260, 230], fill=(178, 34, 34))
# Draw a brown roof
draw.polygon([(130, 140), (205, 80), (280, 140)], fill=(139, 69, 19))
img.save(image_path)
print(f"Sample image '{image_path}' created successfully.")

# 3. Load free local multimodal model (BLIP for image captioning)
processor = BlipProcessor.from_pretrained("Salesforce/blip-image-captioning-base")
model = BlipForConditionalGeneration.from_pretrained("Salesforce/blip-image-captioning-base")

# 4. Open and process the image
raw_image = Image.open(image_path).convert("RGB")
prompt_text = "a photography of"
inputs = processor(raw_image, prompt_text, return_tensors="pt")

# 5. Generate description
out = model.generate(**inputs, max_new_tokens=50)
caption = processor.decode(out[0], skip_special_tokens=True)

print("\n--- MULTIMODAL RESPONSE ---")
print(caption)
